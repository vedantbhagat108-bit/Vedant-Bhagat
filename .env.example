# =========================================================================
# VEDANT BHAGAT PORTFOLIO - ENVIRONMENT CONFIGURATION
# =========================================================================

# 1. NEON / POSTGRES DATABASE (Single Source of Truth for Cross-Device Persistence)
# Get your connection string from Neon Console (e.g. postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require)
POSTGRES_URL=
DATABASE_URL=

# 2. OWNER ADMIN AUTHORIZATION
# Secure password for logging in as owner and publishing customizations across devices
OWNER_PASSWORD=

# 3. VERCEL BLOB STORAGE (For Video Uploads Only)
# Automatically set by Vercel when connecting a Blob store
BLOB_READ_WRITE_TOKEN=

# 4. GOOGLE GEMINI AI (For Cosmo AI Assistant)
GEMINI_API_KEY=
